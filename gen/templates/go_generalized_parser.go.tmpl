// ErrAmbiguous is wrapped by the syntax error returned when the whole input
// admits two or more structurally different complete parses. Callers can use
// errors.Is(err, ErrAmbiguous) to distinguish a genuine ambiguity from a
// plain syntax error.
var ErrAmbiguous error = "errors".New("ambiguous input: more than one complete parse exists")

// AmbiguousError is returned when the input can be parsed in two or more
// structurally different ways (different productions or different parse
// subtrees), even in the case all parses happen to evaluate to the same
// semantic value.
